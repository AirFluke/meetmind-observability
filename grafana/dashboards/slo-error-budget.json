{
  "uid": "slo-error-budget",
  "title": "SLO & Error Budget",
  "tags": ["slo", "reliability", "error-budget"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Availability SLI vs SLO (30d)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "slo:availability:ratio_rate30d * 100",
        "legendFormat": "Availability %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizValue": 99,
        "maxVizValue": 100,
        "thresholds": {
          "steps": [
            { "value": null, "color": "red" },
            { "value": 99.5, "color": "green" }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 99, "max": 100 } }
    },
    {
      "id": 2,
      "title": "Error budget remaining (30d)",
      "type": "bargauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "((1 - 0.995) - (1 - slo:availability:ratio_rate30d)) / (1 - 0.995) * 100",
        "legendFormat": "Budget remaining %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "thresholds": {
          "steps": [
            { "value": null, "color": "red" },
            { "value": 25, "color": "yellow" },
            { "value": 50, "color": "green" }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 3,
      "title": "Fast burn rate (1h window)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "slo:availability:burn_rate1h",
        "legendFormat": "Burn rate (1h)"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 14.4, "color": "red" }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line+area" }
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Slow burn rate (6h window)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "slo:availability:burn_rate6h",
        "legendFormat": "Burn rate (6h)"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 5, "color": "red" }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line+area" }
          }
        }
      }
    },
    {
      "id": 5,
      "title": "SLO compliance history (7d)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "slo:availability:ratio_rate1h * 100",
          "legendFormat": "Availability % (1h)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vector(99.5)",
          "legendFormat": "SLO target (99.5%)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 98, "max": 100 }
      }
    }
  ],
  "schemaVersion": 38
}
