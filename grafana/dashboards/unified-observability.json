{
  "uid": "unified-observability",
  "title": "Unified Observability — Metrics, Logs, Traces",
  "tags": ["unified", "correlation", "traces", "logs"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Error rate — click spike to see correlated logs",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "(sum(count_over_time({job=\"meetmind-be\"} |~ \"(?i)(error|exception|fail|5[0-9]{2})\" [$__interval])) or vector(0)) / sum(count_over_time({job=\"meetmind-be\"} [$__interval])) * 100",
        "legendFormat": "Error rate %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 3,
      "title": "Logs — errors and warnings",
      "type": "logs",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 12 },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{job=\"meetmind-be\"}",
        "legendFormat": ""
      }],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Traffic (requests/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(count_over_time({job=\"meetmind-be\"} [$__interval]))",
        "legendFormat": "meetmind-be throughput"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "title": "Saturation (CPU + memory)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU utilization"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "((sum(node_memory_MemTotal_bytes) - sum(node_memory_MemAvailable_bytes)) / sum(node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Memory utilization"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    }
  ],
  "schemaVersion": 38
}