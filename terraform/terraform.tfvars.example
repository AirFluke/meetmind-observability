# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git — it contains secrets

aws_region    = "eu-west-1"
vpc_id        = "vpc-xxxxxxxxxxxxxxxxx"
subnet_id     = "subnet-xxxxxxxxxxxxxxxxx"
instance_type = "t3.medium"
key_name      = "your-keypair-name"

# Your application server
app_server_ip                = "13.63.206.183"
app_server_security_group_id = "sg-xxxxxxxxxxxxxxxxx"

# Secrets
slack_webhook    = "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
grafana_password = "YourSecurePassword"

# Repo
repo_url = "https://github.com/AirFluke/meetmind-observability.git"
